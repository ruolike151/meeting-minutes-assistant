# 会议纪要助手 · 本地配置模板
#
# 用法：复制成本目录下的 .env，再把 MA_LLM_API_KEY 填上你自己的 Key。
#   Copy-Item .env.example .env
#
# 约定（《M3 编排与检索阶段实施计划》第 7 节）：
#   * .env 不进 git（.gitignore 已排除），Key 不写进代码、文档、日志；
#   * 已经存在的真实环境变量优先于 .env，部署环境可以覆盖本地文件；
#   * 不填 Key 也能跑：MA_LLM_MODE=auto 在没有 Key 时等价于 off，
#     链路自动落到「规则路由 + 混合检索 + 模板装配」，全部测试照样全绿。

# -- LLM（M3）------------------------------------------------------------
# provider 是协议名而不是厂商名：永远走 OpenAI 兼容协议，
# 换厂商只改 base_url + 模型名，代码一行不动。
MA_LLM_PROVIDER=openai
MA_LLM_MODE=live
MA_LLM_BASE_URL=https://api.deepseek.com/v1
MA_LLM_API_KEY=
MA_LLM_MODEL_ROUTE=deepseek-chat
MA_LLM_MODEL_ANSWER=deepseek-chat
MA_LLM_MODEL_MINUTES=deepseek-chat
MA_LLM_TIMEOUT=60

# 结构化输出的约束方式：DeepSeek 走 json_object；支持 json_schema 的端点可改成 json_schema
MA_LLM_STRUCTURED_MODE=json_object

# 费用估算用价目表（元 / 百万 token）：不填就用内置的 deepseek-chat 参考价
# MA_LLM_PRICE_INPUT=1.0
# MA_LLM_PRICE_OUTPUT=2.0

# 路由策略：auto（模型优先 + 规则兜底）| llm（只走模型）| rules（只走规则）
MA_ROUTE_MODE=auto

# 证据支撑性判定：rule（默认，可解析 + 非空）| llm（多一次调用，用于评测消融）
MA_VERIFY_MODE=rule

# -- 文本向量（M3）--------------------------------------------------------
# auto：本地权重就绪就用 bge，否则落 hash；api 必须显式指定（走网络与计费）
MA_TEXT_ENCODER=auto
MA_EMBEDDING_MODEL_DIR=model/bge-small-zh-v1.5
# 走 MA_LLM_BASE_URL 的 /embeddings 端点（只有 MA_TEXT_ENCODER=api 时才用）
MA_EMBEDDING_API_MODEL=

# -- 检索参数（可用 scripts/eval_retrieval.py --sweep 扫描）-----------------
MA_RECALL_K1=50
MA_RECALL_K2=50
MA_RRF_K=60
MA_RETRIEVAL_TOP_K=8
MA_MIN_COSINE=0.50
MA_MIN_COVERAGE=0.34
MA_TOKEN_BUDGET=2400

# -- 会话（M3）-----------------------------------------------------------
MA_HISTORY_ROUNDS=3
