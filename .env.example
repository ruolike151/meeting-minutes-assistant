# 会议纪要助手 · 本地配置模板
#
# 用法：复制成本目录下的 .env，再把 MA_LLM_API_KEY 填上你自己的 Key。
#   Copy-Item .env.example .env
#
# 约定（《M3 编排与检索阶段实施计划》第 7 节）：
#   * .env 不进 git（.gitignore 已排除），Key 不写进代码、文档、日志；
#   * 已经存在的真实环境变量优先于 .env，部署环境可以覆盖本地文件；
#   * 不填 Key 也能跑：MA_LLM_MODE=auto 在没有 Key 时等价于 off，
#     链路自动落到「规则路由 + 混合检索 + 模板装配」，全部测试照样全绿。

# -- LLM（M3）------------------------------------------------------------
# provider 是协议名而不是厂商名：永远走 OpenAI 兼容协议，
# 换厂商只改 base_url + 模型名，代码一行不动。
MA_LLM_PROVIDER=openai
MA_LLM_MODE=live
MA_LLM_BASE_URL=https://api.deepseek.com
MA_LLM_API_KEY=
MA_LLM_MODEL_ROUTE=deepseek-flash
MA_LLM_MODEL_ANSWER=deepseek-flash
MA_LLM_MODEL_MINUTES=deepseek-flash
MA_LLM_TIMEOUT=60

# 结构化输出的约束方式：DeepSeek 走 json_object；支持 json_schema 的端点可改成 json_schema
MA_LLM_STRUCTURED_MODE=json_object

# 费用估算用价目表（元 / 百万 token）：不填就用内置价目表；
# 表里没有的模型名会按 0 计费（宁可少算也不编数字），
# 想看到真实量级就把这两个值填上。
# MA_LLM_PRICE_INPUT=1.0
# MA_LLM_PRICE_OUTPUT=2.0

# 路由策略：auto（模型优先 + 规则兜底）| llm（只走模型）| rules（只走规则）
MA_ROUTE_MODE=auto

# 证据支撑性判定：rule（默认，可解析 + 非空）| llm（多一次调用，用于评测消融）
MA_VERIFY_MODE=rule

# -- 文本向量（M3）--------------------------------------------------------
# auto：本地权重就绪就用 bge，否则落 hash；api 必须显式指定（走网络与计费）
MA_TEXT_ENCODER=auto
MA_EMBEDDING_MODEL_DIR=model/bge-small-zh-v1.5
# 走 MA_LLM_BASE_URL 的 /embeddings 端点（只有 MA_TEXT_ENCODER=api 时才用）
MA_EMBEDDING_API_MODEL=

# -- 检索参数（可用 scripts/eval_retrieval.py --sweep 扫描）-----------------
MA_RECALL_K1=50
MA_RECALL_K2=50
MA_RRF_K=60
MA_RETRIEVAL_TOP_K=8
MA_MIN_COSINE=0.50
MA_MIN_COVERAGE=0.34
MA_TOKEN_BUDGET=2400

# -- 会话（M3）-----------------------------------------------------------
MA_HISTORY_ROUNDS=3

# -- 协同 / 人在回路（M4）--------------------------------------------------
# 检查点后端：sqlite（默认，落 data/checkpoints.sqlite）| memory | off
# off 等价于"不挂起"：纪要生成完直接收尾，用于排障与 M5 的消融对比。
MA_CHECKPOINT_BACKEND=sqlite
# MA_CHECKPOINT_PATH=data/checkpoints.sqlite

# 人工确认闸门：gate（默认，有待确认条目就挂起）| off（不挂起）
MA_REVIEW_MODE=gate
# 低于该置信度的决议 / 待办进入待确认区
MA_REVIEW_CONFIDENCE=0.75
# 单场会议待确认条目上限（超出只挂起前 N 条，避免条目暴涨）
MA_REVIEW_MAX_ITEMS=20

# -- 评测（M5）------------------------------------------------------------
# 标注集目录（默认 samples/annotations/m5）
MA_EVAL_DATASET_DIR=samples/annotations/m5
# 评测产物目录（默认 <data_dir>/eval；逐条明细 raw.json 不入 git）
# MA_EVAL_OUTPUT_DIR=data/eval
# 真实模型评测的 token 上限：超出直接中止（默认 200 万）
MA_EVAL_TOKEN_BUDGET=2000000

# 重排：off（默认，RRF 直接出 top-k，行为与 M3 一致）| cross_encoder（本地 bge-reranker-base）
# 先用 scripts/run_eval_all.py --offline --rerank 跑消融，再决定是否改默认值。
MA_RERANK_MODE=off
MA_RERANK_MODEL_DIR=model/bge-reranker-base
MA_RERANK_TOP_N=20

# 证据 / 要点判定：rule（默认，零成本）| llm（多一次调用，用于消融）
MA_JUDGE_MODE=rule

# -- 可观测（M5，可选）------------------------------------------------------
# 需要先装 requirements-observability.txt；不装、不启用时主路径不 import langfuse
MA_LANGFUSE_ENABLED=false
MA_LANGFUSE_HOST=http://localhost:3000
MA_LANGFUSE_PUBLIC_KEY=
MA_LANGFUSE_SECRET_KEY=
